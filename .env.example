# ---------------------------------------------------------------------------
# Copy this file to .env and fill in all values before running docker-compose
# ---------------------------------------------------------------------------

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=choco_pos_db
DB_USER=choco_user
DB_PASSWORD=change-me-strong-password

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── Media ────────────────────────────────────────────────────────────────────
MEDIA_URL=/media/

# ── Ports (host-side, change if 80/8000 are taken) ───────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=8000

# ── Frontend build arg — URL the browser uses to reach the API ───────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
